-//记录默认的相机位置和控制器目标点
-const defaultCameraPos = skinViewer.camera.position.clone();
-const defaultControlsTarget = skinViewer.controls.target.clone();
-
-function updateDefaultCameraPosition() {
-    defaultCameraPos.copy(skinViewer.camera.position);
